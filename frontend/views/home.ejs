  <script>
    // Countdown timer
    let endTime = new Date().getTime() + (5 * 3600 + 23 * 60 + 47) * 1000;
    setInterval(function() {
      let now = new Date().getTime();
      let diff = Math.max(0, endTime - now);
      let h = Math.floor(diff / 3600000);
      let m = Math.floor((diff % 3600000) / 60000);
      let s = Math.floor((diff % 60000) / 1000);
      document.getElementById('cd-hours').textContent = String(h).padStart(2,'0');
      document.getElementById('cd-mins').textContent = String(m).padStart(2,'0');
      document.getElementById('cd-secs').textContent = String(s).padStart(2,'0');
    }, 1000);

    function newsletter() {
      const email = document.getElementById('nl-email').value;
      document.getElementById('nl-result').innerHTML =
        '<div class="alert alert-success">🎉 Email <strong>' + email + '</strong> đã được đăng ký thành công! Kiểm tra hộp thư của bạn.</div>';
    }

    // Cart badge
    const cart = JSON.parse(localStorage.getItem('cart') || '[]');
    document.querySelectorAll('.cart-badge').forEach(el => el.textContent = cart.length);
  </script>
