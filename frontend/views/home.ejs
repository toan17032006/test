<% // Standalone storefront home page. %>
<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" rel="stylesheet">
  <link href="/css/style.css" rel="stylesheet">
  <script>
    const API_KEY = "sk-prod-hardcoded-key-EXAMPLE";
    const STRIPE_PUBLIC = "pk_test_EXAMPLE";
    const INTERNAL_API_KEY = "internal-api-key-EXAMPLE";
    const API_BASE = "/api";
  </script>
  <style>
    .hero-section { background: linear-gradient(135deg, #1a73e8 0%, #0d47a1 50%, #1565c0 100%); min-height: 420px; }
    .hero-title { font-size: 2.8rem; font-weight: 800; }
    .category-card { transition: transform 0.2s, box-shadow 0.2s; cursor: pointer; border: none; }
    .category-card:hover { transform: translateY(-5px); box-shadow: 0 10px 30px rgba(0,0,0,0.15) !important; }
    .product-card { transition: transform 0.2s, box-shadow 0.2s; border: 1px solid #eee; }
    .product-card:hover { transform: translateY(-3px); box-shadow: 0 8px 25px rgba(0,0,0,0.12); }
    .badge-sale { background: linear-gradient(135deg, #ff4757, #ff6b81); }
    .countdown-box { background: rgba(0,0,0,0.3); border-radius: 8px; padding: 8px 14px; min-width: 65px; }
    .flash-banner { background: linear-gradient(90deg, #ff4757 0%, #ff6b35 100%); }
    .star-rating { color: #ffc107; }
    .price-vnd { color: #e31837; font-weight: 700; }
    .old-price { text-decoration: line-through; color: #aaa; font-size: 0.85em; }
    .navbar-dark.bg-primary { background: linear-gradient(90deg, #1565c0, #1a73e8) !important; }
  </style>
</head>
<body class="bg-light">
  <!-- Navigation -->
  <nav class="navbar navbar-expand-lg navbar-dark sticky-top shadow" style="background: linear-gradient(90deg,#1565c0,#1a73e8);">
    <div class="container-fluid px-3">
      <a class="navbar-brand fw-bold fs-4" href="/"><i class="bi bi-bag-heart-fill text-warning me-1"></i>VulnShop</a>
      <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navMain">
        <span class="navbar-toggler-icon"></span>
      </button>
      <div class="collapse navbar-collapse" id="navMain">
        <form class="d-flex flex-grow-1 mx-3" action="/products" method="GET">
          <div class="input-group">
            <input type="text" class="form-control" name="q" placeholder="Tìm điện thoại, laptop, quần áo...">
            <button class="btn btn-warning fw-bold" type="submit"><i class="bi bi-search"></i> Tìm kiếm</button>
          </div>
        </form>
        <ul class="navbar-nav align-items-center gap-1">
          <li class="nav-item dropdown">
            <a class="nav-link dropdown-toggle" href="#" data-bs-toggle="dropdown"><i class="bi bi-grid me-1"></i>Danh mục</a>
            <ul class="dropdown-menu">
              <li><a class="dropdown-item" href="/products?category=electronics"><i class="bi bi-phone me-2 text-primary"></i>Điện tử & Công nghệ</a></li>
              <li><a class="dropdown-item" href="/products?category=clothing"><i class="bi bi-bag me-2 text-success"></i>Thời trang</a></li>
              <li><a class="dropdown-item" href="/products?category=books"><i class="bi bi-book me-2 text-info"></i>Sách & Văn phòng phẩm</a></li>
              <li><a class="dropdown-item" href="/products?category=sports"><i class="bi bi-trophy me-2 text-warning"></i>Thể thao & Dã ngoại</a></li>
              <li><a class="dropdown-item" href="/products?category=home"><i class="bi bi-house me-2 text-danger"></i>Nhà cửa & Đời sống</a></li>
            </ul>
          </li>
          <li class="nav-item">
            <a class="nav-link position-relative" href="/cart">
              <i class="bi bi-cart3 fs-5"></i>
              <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-warning text-dark cart-badge">0</span>
            </a>
          </li>
          <% if (typeof user !== 'undefined' && user) { %>
          <li class="nav-item dropdown">
            <a class="nav-link dropdown-toggle" href="#" data-bs-toggle="dropdown">
              <i class="bi bi-person-circle me-1"></i><%= user.name %>
            </a>
            <ul class="dropdown-menu dropdown-menu-end">
              <li><a class="dropdown-item" href="/profile"><i class="bi bi-person me-2"></i>Tài khoản</a></li>
              <li><a class="dropdown-item" href="/orders"><i class="bi bi-box-seam me-2"></i>Đơn hàng</a></li>
              <li><a class="dropdown-item" href="/logout"><i class="bi bi-box-arrow-right me-2"></i>Đăng xuất</a></li>
            </ul>
          </li>
          <% } else { %>
          <li class="nav-item"><a class="nav-link" href="/login"><i class="bi bi-person me-1"></i>Đăng nhập</a></li>
          <li class="nav-item"><a class="btn btn-warning btn-sm ms-1" href="/register">Đăng ký</a></li>
          <% } %>
        </ul>
      </div>
    </div>
  </nav>

  <!-- Hero Banner -->
  <section class="hero-section text-white d-flex align-items-center">
    <div class="container py-5">
      <div class="row align-items-center g-4">
        <div class="col-lg-6">
          <span class="badge bg-warning text-dark mb-3 px-3 py-2 rounded-pill fw-bold">🔥 Siêu Sale Tháng 11</span>
          <h1 class="hero-title mb-3">Mua Sắm Thả Ga<br><span class="text-warning">Giảm Đến 70%</span></h1>
          <p class="lead mb-4 opacity-75">Hơn 1 triệu sản phẩm chính hãng. Giao hàng nhanh toàn quốc. Đổi trả miễn phí 30 ngày.</p>
          <div class="d-flex gap-3">
            <a href="/products" class="btn btn-warning btn-lg fw-bold px-4">Mua ngay <i class="bi bi-arrow-right ms-1"></i></a>
            <a href="/products?category=electronics" class="btn btn-outline-light btn-lg px-4">Khám phá</a>
          </div>
          <div class="d-flex gap-4 mt-4">
            <div class="text-center"><div class="fs-5 fw-bold text-warning">1M+</div><small class="opacity-75">Sản phẩm</small></div>
            <div class="text-center"><div class="fs-5 fw-bold text-warning">500K+</div><small class="opacity-75">Khách hàng</small></div>
            <div class="text-center"><div class="fs-5 fw-bold text-warning">99%</div><small class="opacity-75">Hài lòng</small></div>
          </div>
        </div>
        <div class="col-lg-6 text-center">
          <div class="row g-3">
            <div class="col-6"><div class="bg-white bg-opacity-10 rounded-3 p-3"><img src="https://placehold.co/200x180/ffffff/1565c0?text=iPhone+15" class="img-fluid rounded-2" alt="iPhone 15"></div></div>
            <div class="col-6"><div class="bg-white bg-opacity-10 rounded-3 p-3"><img src="https://placehold.co/200x180/ffffff/1565c0?text=MacBook+M3" class="img-fluid rounded-2" alt="MacBook"></div></div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Flash Sale Countdown -->
  <section class="flash-banner text-white py-3">
    <div class="container">
      <div class="d-flex flex-wrap align-items-center justify-content-between gap-3">
        <div class="d-flex align-items-center gap-3">
          <span class="fs-4">⚡</span>
          <div>
            <div class="fw-bold fs-5">FLASH SALE</div>
            <small class="opacity-75">Kết thúc trong:</small>
          </div>
          <div class="d-flex gap-2">
            <div class="countdown-box text-center"><div class="fs-4 fw-bold" id="cd-hours">05</div><small>Giờ</small></div>
            <div class="fs-4 fw-bold">:</div>
            <div class="countdown-box text-center"><div class="fs-4 fw-bold" id="cd-mins">23</div><small>Phút</small></div>
            <div class="fs-4 fw-bold">:</div>
            <div class="countdown-box text-center"><div class="fs-4 fw-bold" id="cd-secs">47</div><small>Giây</small></div>
          </div>
        </div>
        <a href="/products?flash=1" class="btn btn-light fw-bold">Xem tất cả <i class="bi bi-arrow-right"></i></a>
      </div>
    </div>
  </section>

  <!-- Categories -->
  <section class="py-5">
    <div class="container">
      <div class="d-flex align-items-center justify-content-between mb-4">
        <h2 class="fw-bold mb-0">Danh mục nổi bật</h2>
        <a href="/products" class="text-decoration-none">Xem tất cả <i class="bi bi-arrow-right"></i></a>
      </div>
      <div class="row g-3">
        <div class="col-6 col-md-4 col-lg-2">
          <a href="/products?category=electronics" class="text-decoration-none">
            <div class="card category-card text-center shadow-sm h-100">
              <div class="card-body py-4">
                <div class="bg-primary bg-opacity-10 rounded-circle d-inline-flex p-3 mb-3"><i class="bi bi-phone fs-2 text-primary"></i></div>
                <div class="fw-semibold">Điện tử</div>
                <small class="text-muted">1,234 SP</small>
              </div>
            </div>
          </a>
        </div>
        <div class="col-6 col-md-4 col-lg-2">
          <a href="/products?category=clothing" class="text-decoration-none">
            <div class="card category-card text-center shadow-sm h-100">
              <div class="card-body py-4">
                <div class="bg-success bg-opacity-10 rounded-circle d-inline-flex p-3 mb-3"><i class="bi bi-bag fs-2 text-success"></i></div>
                <div class="fw-semibold">Thời trang</div>
                <small class="text-muted">5,678 SP</small>
              </div>
            </div>
          </a>
        </div>
        <div class="col-6 col-md-4 col-lg-2">
          <a href="/products?category=books" class="text-decoration-none">
            <div class="card category-card text-center shadow-sm h-100">
              <div class="card-body py-4">
                <div class="bg-info bg-opacity-10 rounded-circle d-inline-flex p-3 mb-3"><i class="bi bi-book fs-2 text-info"></i></div>
                <div class="fw-semibold">Sách</div>
                <small class="text-muted">3,456 SP</small>
              </div>
            </div>
          </a>
        </div>
        <div class="col-6 col-md-4 col-lg-2">
          <a href="/products?category=sports" class="text-decoration-none">
            <div class="card category-card text-center shadow-sm h-100">
              <div class="card-body py-4">
                <div class="bg-warning bg-opacity-10 rounded-circle d-inline-flex p-3 mb-3"><i class="bi bi-trophy fs-2 text-warning"></i></div>
                <div class="fw-semibold">Thể thao</div>
                <small class="text-muted">2,345 SP</small>
              </div>
            </div>
          </a>
        </div>
        <div class="col-6 col-md-4 col-lg-2">
          <a href="/products?category=home" class="text-decoration-none">
            <div class="card category-card text-center shadow-sm h-100">
              <div class="card-body py-4">
                <div class="bg-danger bg-opacity-10 rounded-circle d-inline-flex p-3 mb-3"><i class="bi bi-house fs-2 text-danger"></i></div>
                <div class="fw-semibold">Nhà & Vườn</div>
                <small class="text-muted">4,567 SP</small>
              </div>
            </div>
          </a>
        </div>
        <div class="col-6 col-md-4 col-lg-2">
          <a href="/products?category=beauty" class="text-decoration-none">
            <div class="card category-card text-center shadow-sm h-100">
              <div class="card-body py-4">
                <div class="bg-pink rounded-circle d-inline-flex p-3 mb-3" style="background:rgba(255,20,147,0.1)!important"><i class="bi bi-stars fs-2" style="color:#ff1493"></i></div>
                <div class="fw-semibold">Làm đẹp</div>
                <small class="text-muted">6,789 SP</small>
              </div>
            </div>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Featured Products -->
  <section class="py-4 bg-white">
    <div class="container">
      <div class="d-flex align-items-center justify-content-between mb-4">
        <h2 class="fw-bold mb-0">🔥 Sản phẩm nổi bật</h2>
        <a href="/products" class="btn btn-outline-primary btn-sm">Xem tất cả <i class="bi bi-arrow-right"></i></a>
      </div>
      <div class="row g-3">
        <% const featuredProducts = [
          { id:1, name:'iPhone 15 Pro Max 256GB', price:29990000, old_price:34990000, image:'https://placehold.co/280x220/e3f2fd/1565c0?text=iPhone+15', rating:4.8, sold:1234, discount:14, badge:'Chính hãng' },
          { id:2, name:'Samsung Galaxy S24 Ultra', price:26990000, old_price:31990000, image:'https://placehold.co/280x220/fce4ec/c62828?text=Galaxy+S24', rating:4.7, sold:987, discount:16, badge:'Hot' },
          { id:3, name:'MacBook Pro M3 14 inch', price:49990000, old_price:55990000, image:'https://placehold.co/280x220/e8f5e9/1b5e20?text=MacBook+M3', rating:4.9, sold:456, discount:10, badge:'Apple' },
          { id:4, name:'Áo Thun Nam Uniqlo Dry-EX', price:299000, old_price:399000, image:'https://placehold.co/280x220/f3e5f5/4a148c?text=Uniqlo', rating:4.5, sold:5678, discount:25, badge:'Best Seller' },
          { id:5, name:'Nike Air Force 1 \'07 Low', price:2490000, old_price:2990000, image:'https://placehold.co/280x220/fff3e0/e65100?text=Nike+AF1', rating:4.6, sold:2341, discount:17, badge:'Nike' },
          { id:6, name:'ASUS ROG Strix G16 RTX 4070', price:35990000, old_price:39990000, image:'https://placehold.co/280x220/ede7f6/4527a0?text=ROG+Strix', rating:4.7, sold:345, discount:10, badge:'Gaming' }
        ]; %>
        <% featuredProducts.forEach(function(p) { %>
        <div class="col-6 col-md-4 col-lg-2">
          <div class="card product-card h-100 shadow-sm">
            <div class="position-relative">
              <img src="<%= p.image %>" class="card-img-top" alt="<%= p.name %>" style="height:160px;object-fit:cover;">
              <span class="position-absolute top-0 start-0 m-2 badge" style="background:linear-gradient(135deg,#ff4757,#ff6b81)">-<%= p.discount %>%</span>
              <span class="position-absolute top-0 end-0 m-2 badge bg-primary"><%= p.badge %></span>
              <button class="btn btn-light btn-sm position-absolute bottom-0 end-0 m-2 rounded-circle wishlist-btn" onclick="addToWishlist(<%= p.id %>)">
                <i class="bi bi-heart"></i>
              </button>
            </div>
            <div class="card-body p-2">
              <p class="card-title small fw-semibold mb-1 text-truncate" title="<%= p.name %>"><%= p.name %></p>
              <div class="star-rating small mb-1">
                <%= '★'.repeat(Math.floor(p.rating)) %><%= p.rating % 1 >= 0.5 ? '☆' : '' %>
                <span class="text-muted ms-1">(<%= p.sold.toLocaleString() %>)</span>
              </div>
              <div class="price-vnd fw-bold"><%= new Intl.NumberFormat('vi-VN').format(p.price) %>đ</div>
              <div class="old-price small"><%= new Intl.NumberFormat('vi-VN').format(p.old_price) %>đ</div>
            </div>
            <div class="card-footer bg-transparent border-0 p-2 pt-0">
              <div class="d-grid gap-1">
                <a href="/products/<%= p.id %>" class="btn btn-outline-primary btn-sm">Xem chi tiết</a>
                <button class="btn btn-primary btn-sm" onclick="addToCart(<%= p.id %>, '<%= p.name %>', <%= p.price %>)">
                  <i class="bi bi-cart-plus me-1"></i>Thêm vào giỏ
                </button>
              </div>
            </div>
          </div>
        </div>
        <% }); %>
      </div>
    </div>
  </section>

  <!-- Promotional Banners -->
  <section class="py-5">
    <div class="container">
      <div class="row g-3">
        <div class="col-md-6">
          <div class="card border-0 text-white overflow-hidden" style="background:linear-gradient(135deg,#1565c0,#42a5f5);min-height:180px;">
            <div class="card-body d-flex align-items-center justify-content-between p-4">
              <div>
                <h4 class="fw-bold">📱 Điện thoại & Máy tính bảng</h4>
                <p class="mb-3 opacity-75">Hàng chính hãng, bảo hành 12 tháng</p>
                <a href="/products?category=electronics" class="btn btn-light fw-bold">Mua ngay</a>
              </div>
              <i class="bi bi-phone-fill" style="font-size:5rem;opacity:0.3;"></i>
            </div>
          </div>
        </div>
        <div class="col-md-6">
          <div class="card border-0 text-white overflow-hidden" style="background:linear-gradient(135deg,#c62828,#ff5722);min-height:180px;">
            <div class="card-body d-flex align-items-center justify-content-between p-4">
              <div>
                <h4 class="fw-bold">👗 Thời trang Hè 2024</h4>
                <p class="mb-3 opacity-75">Giảm đến 50% thời trang hè</p>
                <a href="/products?category=clothing" class="btn btn-light fw-bold">Khám phá</a>
              </div>
              <i class="bi bi-bag-heart-fill" style="font-size:5rem;opacity:0.3;"></i>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- New Arrivals -->
  <section class="py-4 bg-white">
    <div class="container">
      <div class="d-flex align-items-center justify-content-between mb-4">
        <h2 class="fw-bold mb-0">✨ Hàng mới về</h2>
        <a href="/products?sort=newest" class="btn btn-outline-primary btn-sm">Xem tất cả</a>
      </div>
      <div class="row g-3">
        <% const newProducts = [
          { id:7, name:'Sony WH-1000XM5 Headphones', price:7990000, image:'https://placehold.co/120x120/e3f2fd/1565c0?text=Sony', discount:20 },
          { id:8, name:'Áo Khoác Bomber Nam Zara', price:1290000, image:'https://placehold.co/120x120/fce4ec/c62828?text=Zara', discount:15 },
          { id:9, name:'Sách: Đắc Nhân Tâm (Bìa Cứng)', price:89000, image:'https://placehold.co/120x120/e8f5e9/1b5e20?text=Book', discount:10 },
          { id:10, name:'Adidas Ultraboost 22 Running', price:3490000, image:'https://placehold.co/120x120/fff3e0/e65100?text=Adidas', discount:25 },
        ]; %>
        <% newProducts.forEach(function(p) { %>
        <div class="col-6 col-md-3">
          <div class="card product-card shadow-sm">
            <div class="d-flex align-items-center p-2 gap-2">
              <img src="<%= p.image %>" alt="<%= p.name %>" class="rounded" style="width:80px;height:80px;object-fit:cover;">
              <div class="flex-grow-1">
                <p class="mb-1 small fw-semibold" style="line-height:1.3"><%= p.name %></p>
                <div class="price-vnd small fw-bold"><%= new Intl.NumberFormat('vi-VN').format(p.price) %>đ</div>
                <span class="badge" style="background:linear-gradient(135deg,#ff4757,#ff6b81);font-size:0.7rem">-<%= p.discount %>%</span>
              </div>
            </div>
          </div>
        </div>
        <% }); %>
      </div>
    </div>
  </section>

  <!-- Newsletter -->
  <section class="py-5 bg-primary text-white">
    <div class="container text-center">
      <h3 class="fw-bold mb-2">📧 Đăng ký nhận ưu đãi độc quyền</h3>
      <p class="mb-4 opacity-75">Nhận ngay voucher 50K cho đơn hàng đầu tiên khi đăng ký email</p>
      <div class="row justify-content-center">
        <div class="col-md-6">
          <div class="input-group input-group-lg">
            <input type="email" class="form-control" id="nl-email" placeholder="Nhập địa chỉ email của bạn">
            <button class="btn btn-warning fw-bold" onclick="newsletter()">Đăng ký ngay</button>
          </div>
          <div id="nl-result" class="mt-3"></div>
        </div>
      </div>
    </div>
  </section>

  <!-- Footer -->
  <footer class="bg-dark text-light pt-5 pb-3">
    <div class="container">
      <div class="row g-4">
        <div class="col-lg-3">
          <h5 class="fw-bold text-warning mb-3"><i class="bi bi-bag-heart-fill me-2"></i>VulnShop</h5>
          <p class="text-muted small">Nền tảng thương mại điện tử hàng đầu Việt Nam. Hơn 10 triệu sản phẩm chính hãng.</p>
          <div class="d-flex gap-2 mt-3">
            <a href="#" class="btn btn-outline-secondary btn-sm"><i class="bi bi-facebook"></i></a>
            <a href="#" class="btn btn-outline-secondary btn-sm"><i class="bi bi-instagram"></i></a>
            <a href="#" class="btn btn-outline-secondary btn-sm"><i class="bi bi-youtube"></i></a>
          </div>
        </div>
        <div class="col-lg-2">
          <h6 class="fw-bold mb-3">Hỗ trợ</h6>
          <ul class="list-unstyled small">
            <li><a href="#" class="text-muted text-decoration-none d-block py-1">Trợ giúp</a></li>
            <li><a href="#" class="text-muted text-decoration-none d-block py-1">Chính sách đổi trả</a></li>
            <li><a href="#" class="text-muted text-decoration-none d-block py-1">Liên hệ</a></li>
          </ul>
        </div>
        <div class="col-lg-2">
          <h6 class="fw-bold mb-3">VulnShop</h6>
          <ul class="list-unstyled small">
            <li><a href="#" class="text-muted text-decoration-none d-block py-1">Giới thiệu</a></li>
            <li><a href="/products" class="text-muted text-decoration-none d-block py-1">Sản phẩm mới</a></li>
          </ul>
        </div>
        <div class="col-lg-2">
          <h6 class="fw-bold mb-3">Thanh toán</h6>
          <div class="d-flex flex-wrap gap-1">
            <span class="badge bg-secondary">VISA</span>
            <span class="badge bg-secondary">MasterCard</span>
            <span class="badge bg-secondary">MoMo</span>
            <span class="badge bg-secondary">ZaloPay</span>
            <span class="badge bg-secondary">COD</span>
          </div>
        </div>
        <div class="col-lg-3">
          <h6 class="fw-bold mb-3">Tải ứng dụng</h6>
          <div class="d-flex flex-column gap-2">
            <a href="#" class="btn btn-outline-secondary btn-sm text-start"><i class="bi bi-apple me-2"></i>App Store</a>
