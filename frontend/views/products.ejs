<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" rel="stylesheet">
  <link href="/css/style.css" rel="stylesheet">
  <style>
    .product-card { transition: transform 0.2s, box-shadow 0.2s; }
    .product-card:hover { transform: translateY(-3px); box-shadow: 0 8px 25px rgba(0,0,0,0.12); }
    .price-vnd { color: #e31837; font-weight: 700; }
    .old-price { text-decoration: line-through; color: #aaa; font-size: 0.85em; }
    .star-rating { color: #ffc107; }
    .filter-card { border: 1px solid #e9ecef; }
    .sort-bar { background: #f8f9fa; }
    .navbar-dark { background: linear-gradient(90deg,#1565c0,#1a73e8) !important; }
  </style>
</head>
<body class="bg-light">
  <!-- Nav -->
  <nav class="navbar navbar-expand-lg navbar-dark sticky-top shadow" style="background:linear-gradient(90deg,#1565c0,#1a73e8);">
    <div class="container-fluid px-3">
      <a class="navbar-brand fw-bold" href="/"><i class="bi bi-bag-heart-fill text-warning me-1"></i>VulnShop</a>
      <div class="d-flex flex-grow-1 mx-3">
        <form class="d-flex w-100" action="/products" method="GET">
          <div class="input-group">
            <input type="text" class="form-control" name="q" value="<%= query %>" placeholder="Tìm kiếm sản phẩm...">
            <button class="btn btn-warning" type="submit"><i class="bi bi-search"></i></button>
          </div>
        </form>
      </div>
      <div class="d-flex align-items-center gap-2">
        <a href="/cart" class="btn btn-outline-light btn-sm position-relative">
          <i class="bi bi-cart3"></i>
          <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-warning text-dark cart-badge">0</span>
        </a>
        <% if (typeof user !== 'undefined' && user) { %>
        <a href="/profile" class="btn btn-outline-light btn-sm"><i class="bi bi-person"></i> <%= user.name %></a>
        <% } else { %>
        <a href="/login" class="btn btn-outline-light btn-sm">Đăng nhập</a>
        <% } %>
      </div>
    </div>
  </nav>

  <!-- Breadcrumb + Search result notice -->
  <div class="bg-white border-bottom py-2">
    <div class="container">
      <nav aria-label="breadcrumb">
        <ol class="breadcrumb mb-0 small">
          <li class="breadcrumb-item"><a href="/" class="text-decoration-none">Trang chủ</a></li>
          <li class="breadcrumb-item active">Sản phẩm</li>
          <% if (category) { %><li class="breadcrumb-item active"><%= category %></li><% } %>
        </ol>
      </nav>
    </div>
  </div>

  <div class="container py-4">
    <!-- VULN: XSS - search query rendered unescaped with <%- %> -->
    <% if (query) { %>
    <div class="alert alert-info d-flex align-items-center mb-4">
      <i class="bi bi-search me-2 fs-5"></i>
      <div>
        Kết quả tìm kiếm cho: <strong><%- query %></strong>
        <!-- ^^^ INTENTIONAL XSS VULNERABILITY - unescaped output -->
        <span class="text-muted ms-2">(<%= products.length %> sản phẩm)</span>
      </div>
    </div>
    <% } %>

    <div class="row g-4">
      <!-- Sidebar Filters -->
      <div class="col-lg-3">
        <form method="GET" action="/products" id="filter-form">
          <input type="hidden" name="q" value="<%= query %>">

          <!-- Category Filter -->
          <div class="card filter-card mb-3">
            <div class="card-header fw-bold bg-white"><i class="bi bi-funnel me-2 text-primary"></i>Danh mục</div>
            <div class="card-body">
              <% const cats = [{k:'electronics',l:'Điện tử & Công nghệ',n:1234},{k:'clothing',l:'Thời trang',n:5678},{k:'books',l:'Sách & Văn phòng',n:3456},{k:'sports',l:'Thể thao',n:2345},{k:'home',l:'Nhà cửa & Đời sống',n:4567},{k:'beauty',l:'Làm đẹp',n:6789}]; %>
              <% cats.forEach(function(c) { %>
              <div class="form-check">
                <input class="form-check-input" type="radio" name="category" value="<%= c.k %>" id="cat-<%= c.k %>" <%= (typeof category !== 'undefined' && category === c.k) ? 'checked' : '' %>>
                <label class="form-check-label d-flex justify-content-between" for="cat-<%= c.k %>">
                  <%= c.l %> <span class="text-muted small">(<%= c.n.toLocaleString() %>)</span>
                </label>
              </div>
              <% }); %>
            </div>
          </div>

          <!-- Price Range Filter -->
          <div class="card filter-card mb-3">
            <div class="card-header fw-bold bg-white"><i class="bi bi-currency-dollar me-2 text-success"></i>Khoảng giá</div>
            <div class="card-body">
              <% const priceRanges = [
                {l:'Dưới 100.000đ', min:0, max:100000},
                {l:'100.000đ - 500.000đ', min:100000, max:500000},
                {l:'500.000đ - 2.000.000đ', min:500000, max:2000000},
                {l:'2.000.000đ - 10.000.000đ', min:2000000, max:10000000},
                {l:'Trên 10.000.000đ', min:10000000, max:999999999}
              ]; %>
              <% priceRanges.forEach(function(r,i) { %>
              <div class="form-check">
                <input class="form-check-input" type="radio" name="price_range" value="<%= r.min %>-<%= r.max %>" id="pr-<%= i %>">
                <label class="form-check-label" for="pr-<%= i %>"><%= r.l %></label>
              </div>
              <% }); %>
              <div class="mt-3">
                <div class="row g-2">
                  <div class="col"><input type="number" class="form-control form-control-sm" name="min_price" placeholder="Từ" value="<%= typeof minPrice !== 'undefined' ? minPrice : '' %>"></div>
                  <div class="col-auto d-flex align-items-center">—</div>
                  <div class="col"><input type="number" class="form-control form-control-sm" name="max_price" placeholder="Đến" value="<%= typeof maxPrice !== 'undefined' ? maxPrice : '' %>"></div>
                </div>
              </div>
            </div>
          </div>

          <!-- Brand Filter -->
          <div class="card filter-card mb-3">
            <div class="card-header fw-bold bg-white"><i class="bi bi-bookmark me-2 text-info"></i>Thương hiệu</div>
            <div class="card-body">
              <% const brandsData = typeof brands !== 'undefined' ? brands : ['Apple','Samsung','ASUS','Nike','Uniqlo','Sony','Adidas','Zara']; %>
              <% brandsData.forEach(function(b) { %>
              <div class="form-check">
                <input class="form-check-input" type="checkbox" name="brand" value="<%= b %>" id="br-<%= b %>" <%= (typeof brand !== 'undefined' && brand === b) ? 'checked' : '' %>>
                <label class="form-check-label" for="br-<%= b %>"><%= b %></label>
              </div>
              <% }); %>
            </div>
          </div>

          <!-- Rating Filter -->
          <div class="card filter-card mb-3">
            <div class="card-header fw-bold bg-white"><i class="bi bi-star me-2 text-warning"></i>Đánh giá</div>
            <div class="card-body">
              <% [5,4,3,2,1].forEach(function(r) { %>
              <div class="form-check">
                <input class="form-check-input" type="radio" name="rating" value="<%= r %>" id="rt-<%= r %>">
                <label class="form-check-label" for="rt-<%= r %>">
                  <span class="text-warning"><%= '★'.repeat(r) %><%= '☆'.repeat(5-r) %></span>
                  <span class="text-muted small ms-1">trở lên</span>
                </label>
              </div>
              <% }); %>
            </div>
          </div>

          <div class="d-grid gap-2">
            <button type="submit" class="btn btn-primary">Áp dụng bộ lọc</button>
            <a href="/products<%= query ? '?q=' + query : '' %>" class="btn btn-outline-secondary">Xóa bộ lọc</a>
          </div>
        </form>
      </div>

      <!-- Product Grid -->
      <div class="col-lg-9">
        <!-- Sort bar -->
        <div class="sort-bar d-flex flex-wrap align-items-center justify-content-between p-3 rounded mb-3">
          <span class="text-muted small"><strong><%= products.length %></strong> sản phẩm</span>
          <div class="d-flex align-items-center gap-2">
            <span class="text-muted small">Sắp xếp:</span>
            <select class="form-select form-select-sm" style="width:auto" onchange="sortProducts(this.value)">
              <option value="popular" <%= (typeof sort !== 'undefined' && sort === 'popular') ? 'selected' : '' %>>Phổ biến nhất</option>
              <option value="newest" <%= (typeof sort !== 'undefined' && sort === 'newest') ? 'selected' : '' %>>Mới nhất</option>
              <option value="price_asc" <%= (typeof sort !== 'undefined' && sort === 'price_asc') ? 'selected' : '' %>>Giá tăng dần</option>
              <option value="price_desc" <%= (typeof sort !== 'undefined' && sort === 'price_desc') ? 'selected' : '' %>>Giá giảm dần</option>
              <option value="rating" <%= (typeof sort !== 'undefined' && sort === 'rating') ? 'selected' : '' %>>Đánh giá cao</option>
            </select>
            <div class="btn-group btn-group-sm">
              <button class="btn btn-outline-secondary active" id="view-grid" onclick="switchView('grid')"><i class="bi bi-grid"></i></button>
              <button class="btn btn-outline-secondary" id="view-list" onclick="switchView('list')"><i class="bi bi-list-ul"></i></button>
            </div>
          </div>
        </div>

        <!-- Products Grid -->
        <div class="row g-3" id="product-grid">
          <% if (products && products.length > 0) { %>
            <% products.forEach(function(p) { %>
            <div class="col-6 col-md-4">
              <div class="card product-card h-100 shadow-sm">
                <div class="position-relative">
                  <img src="<%= p.image || 'https://placehold.co/280x220/e3f2fd/1565c0?text=' + encodeURIComponent(p.name) %>"
                    class="card-img-top" alt="<%= p.name %>" style="height:180px;object-fit:cover;">
                  <% if (p.old_price && p.price < p.old_price) { %>
                  <span class="position-absolute top-0 start-0 m-2 badge" style="background:linear-gradient(135deg,#ff4757,#ff6b81)">
                    -<%= Math.round((1 - p.price/p.old_price)*100) %>%
                  </span>
                  <% } %>
                  <button class="btn btn-light btn-sm position-absolute top-0 end-0 m-2 rounded-circle" onclick="toggleWishlist(<%= p.id %>)">
                    <i class="bi bi-heart" id="wish-<%= p.id %>"></i>
                  </button>
                </div>
                <div class="card-body p-2">
                  <div class="text-muted small mb-1"><%= p.brand || 'VulnShop' %></div>
                  <p class="fw-semibold mb-1 small" style="line-height:1.4;min-height:2.8em"><%= p.name %></p>
                  <div class="star-rating small mb-1">
                    <% for(let i=0;i<5;i++){%><%= i < Math.floor(p.rating||4) ? '★' : '☆' %><% } %>
                    <span class="text-muted ms-1 small">(<%= (p.sold||0).toLocaleString() %>)</span>
                  </div>
                  <div class="price-vnd fw-bold fs-6"><%= new Intl.NumberFormat('vi-VN').format(p.price) %>đ</div>
                  <% if (p.old_price) { %>
                  <div class="old-price small text-muted"><%= new Intl.NumberFormat('vi-VN').format(p.old_price) %>đ</div>
                  <% } %>
                  <% if (p.stock && p.stock < 10) { %>
                  <div class="text-danger small mt-1"><i class="bi bi-exclamation-circle me-1"></i>Chỉ còn <%= p.stock %> SP</div>
                  <% } %>
                </div>
                <div class="card-footer bg-transparent border-0 p-2 pt-0">
                  <div class="d-grid gap-1">
                    <a href="/products/<%= p.id %>" class="btn btn-outline-primary btn-sm">Xem chi tiết</a>
                    <button class="btn btn-primary btn-sm" onclick="addToCart(<%= p.id %>, '<%= p.name.replace(/'/g, "\\'") %>', <%= p.price %>, '<%= p.image || '' %>')">
                      <i class="bi bi-cart-plus me-1"></i>Thêm vào giỏ
                    </button>
                  </div>
                </div>
              </div>
            </div>
            <% }); %>
          <% } else { %>
          <div class="col-12 text-center py-5">
            <i class="bi bi-search text-muted" style="font-size:4rem;"></i>
            <h4 class="mt-3 text-muted">Không tìm thấy sản phẩm</h4>
            <p class="text-muted">Thử tìm kiếm với từ khóa khác hoặc điều chỉnh bộ lọc</p>
            <a href="/products" class="btn btn-primary">Xem tất cả sản phẩm</a>
          </div>
          <% } %>
        </div>

        <!-- Pagination -->
        <% if (typeof totalPages !== 'undefined' && totalPages > 1) { %>
        <nav class="mt-4">
          <ul class="pagination justify-content-center">
            <li class="page-item <%= (typeof page === 'undefined' || page <= 1) ? 'disabled' : '' %>">
              <a class="page-link" href="?<%= new URLSearchParams({q: query||'', category: category||'', sort: sort||'', page: (page||1)-1}).toString() %>">‹ Trước</a>
            </li>
            <% for(let i=1; i<=Math.min(totalPages,10); i++) { %>
            <li class="page-item <%= (typeof page !== 'undefined' && page === i) ? 'active' : '' %>">
              <a class="page-link" href="?<%= new URLSearchParams({q: query||'', category: category||'', sort: sort||'', page: i}).toString() %>"><%= i %></a>
            </li>
            <% } %>
            <li class="page-item <%= (typeof page === 'undefined' || page >= totalPages) ? 'disabled' : '' %>">
              <a class="page-link" href="?<%= new URLSearchParams({q: query||'', category: category||'', sort: sort||'', page: (page||1)+1}).toString() %>">Sau ›</a>
            </li>
          </ul>
        </nav>
        <% } %>
      </div>
    </div>
  </div>

  <footer class="bg-dark text-muted py-4 mt-5">
    <div class="container text-center">
      <p class="mb-0 small">© 2024 VulnShop — Hotline: 1900-6035</p>
    </div>
  </footer>

  <script src="https://code.jquery.com/jquery-1.12.4.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
  <script src="/js/app.js"></script>
  <script>
    const cart = JSON.parse(localStorage.getItem('cart') || '[]');
    document.querySelectorAll('.cart-badge').forEach(el => el.textContent = cart.length);

    function sortProducts(val) {
      const url = new URL(window.location.href);
      url.searchParams.set('sort', val);
      window.location.href = url.toString();
    }

    function switchView(mode) {
      document.getElementById('view-grid').classList.toggle('active', mode === 'grid');
      document.getElementById('view-list').classList.toggle('active', mode === 'list');
    }

    function toggleWishlist(id) {
      let wish = JSON.parse(localStorage.getItem('wishlist') || '[]');
      const idx = wish.indexOf(id);
      if (idx === -1) { wish.push(id); document.getElementById('wish-' + id).className = 'bi bi-heart-fill text-danger'; }
      else { wish.splice(idx, 1); document.getElementById('wish-' + id).className = 'bi bi-heart'; }
      localStorage.setItem('wishlist', JSON.stringify(wish));
    }
  </script>
</body>
</html>
