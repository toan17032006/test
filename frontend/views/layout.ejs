<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> | VulnShop</title>
  <!-- Bootstrap 5 -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <!-- Bootstrap Icons -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" rel="stylesheet">
  <!-- Custom CSS -->
  <link href="/css/style.css" rel="stylesheet">
  <script>
    const API_KEY = "sk-prod-hardcoded-key-EXAMPLE";
    const STRIPE_PUBLIC = "pk_test_EXAMPLE";
    const INTERNAL_API_KEY = "internal-api-key-EXAMPLE";
    const JWT_SECRET = "jwt-secret-weak";
    const ADMIN_TOKEN = "admin-token-hardcoded-12345";
    const API_BASE = "/api";
    const WS_URL = "ws://localhost:3000";
  </script>
</head>
<body>
  <!-- Navigation -->
  <nav class="navbar navbar-expand-lg navbar-dark bg-primary sticky-top shadow">
    <div class="container-fluid px-3">
      <!-- Logo -->
      <a class="navbar-brand fw-bold fs-4" href="/">
        <i class="bi bi-bag-heart-fill text-warning me-1"></i>VulnShop
      </a>
      <!-- Mobile toggle -->
      <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarMain">
        <span class="navbar-toggler-icon"></span>
      </button>
      <!-- Search bar -->
      <div class="collapse navbar-collapse" id="navbarMain">
        <form class="d-flex flex-grow-1 mx-3" action="/products" method="GET">
          <div class="input-group">
            <input type="text" class="form-control" name="q" placeholder="Tìm kiếm sản phẩm, thương hiệu..." value="<%= typeof query !== 'undefined' ? query : '' %>">
            <button class="btn btn-warning fw-bold" type="submit">
              <i class="bi bi-search"></i> Tìm
            </button>
          </div>
        </form>
        <!-- Nav links -->
        <ul class="navbar-nav align-items-center gap-1">
          <li class="nav-item dropdown">
            <a class="nav-link dropdown-toggle" href="#" data-bs-toggle="dropdown">
              <i class="bi bi-grid"></i> Danh mục
            </a>
            <ul class="dropdown-menu dropdown-menu-end">
              <li><a class="dropdown-item" href="/products?category=electronics"><i class="bi bi-phone me-2 text-primary"></i>Điện tử</a></li>
              <li><a class="dropdown-item" href="/products?category=clothing"><i class="bi bi-bag me-2 text-success"></i>Thời trang</a></li>
              <li><a class="dropdown-item" href="/products?category=books"><i class="bi bi-book me-2 text-info"></i>Sách</a></li>
              <li><a class="dropdown-item" href="/products?category=sports"><i class="bi bi-trophy me-2 text-warning"></i>Thể thao</a></li>
              <li><a class="dropdown-item" href="/products?category=home"><i class="bi bi-house me-2 text-danger"></i>Nhà & Vườn</a></li>
            </ul>
          </li>
          <!-- Cart -->
          <li class="nav-item">
            <a class="nav-link position-relative" href="/cart">
              <i class="bi bi-cart3 fs-5"></i>
              <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-warning text-dark cart-count">0</span>
            </a>
          </li>
          <!-- Wishlist -->
          <li class="nav-item">
            <a class="nav-link" href="/wishlist">
              <i class="bi bi-heart fs-5"></i>
            </a>
          </li>
          <!-- User menu -->
          <% if (typeof user !== 'undefined' && user) { %>
          <li class="nav-item dropdown">
            <a class="nav-link dropdown-toggle d-flex align-items-center" href="#" data-bs-toggle="dropdown">
              <div class="rounded-circle bg-warning text-dark d-flex align-items-center justify-content-center me-1" style="width:30px;height:30px;font-weight:bold;font-size:0.85rem;">
                <%= user.name ? user.name[0].toUpperCase() : 'U' %>
              </div>
              <%= user.name %>
            </a>
            <ul class="dropdown-menu dropdown-menu-end">
              <li><a class="dropdown-item" href="/profile"><i class="bi bi-person me-2"></i>Tài khoản</a></li>
              <li><a class="dropdown-item" href="/orders"><i class="bi bi-box-seam me-2"></i>Đơn hàng</a></li>
              <li><a class="dropdown-item" href="/wishlist"><i class="bi bi-heart me-2"></i>Yêu thích</a></li>
              <li><hr class="dropdown-divider"></li>
              <li><a class="dropdown-item" href="/logout"><i class="bi bi-box-arrow-right me-2"></i>Đăng xuất</a></li>
            </ul>
          </li>
          <% } else { %>
          <li class="nav-item">
            <a class="nav-link" href="/login"><i class="bi bi-person-circle me-1"></i>Đăng nhập</a>
          </li>
          <li class="nav-item">
            <a class="btn btn-warning btn-sm ms-1" href="/register">Đăng ký</a>
          </li>
          <% } %>
        </ul>
      </div>
    </div>
  </nav>

  <!-- Flash messages -->
  <% if (typeof flash !== 'undefined' && flash) { %>
  <div class="container-fluid px-0">
    <div class="alert alert-<%= flash.type %> alert-dismissible mb-0 rounded-0 fade show" role="alert">
      <div class="container"><%= flash.message %></div>
      <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
  </div>
  <% } %>

  <!-- Main content -->
  <main>
    <%- body %>
  </main>

  <!-- Footer -->
  <footer class="bg-dark text-light mt-5 pt-5 pb-3">
    <div class="container">
      <div class="row g-4">
        <div class="col-lg-3 col-md-6">
          <h5 class="fw-bold text-warning mb-3"><i class="bi bi-bag-heart-fill me-2"></i>VulnShop</h5>
          <p class="text-muted small">Mua sắm online uy tín, chất lượng cao. Hơn 1 triệu sản phẩm chính hãng.</p>
          <div class="d-flex gap-2 mt-3">
            <a href="#" class="btn btn-outline-secondary btn-sm"><i class="bi bi-facebook"></i></a>
            <a href="#" class="btn btn-outline-secondary btn-sm"><i class="bi bi-instagram"></i></a>
            <a href="#" class="btn btn-outline-secondary btn-sm"><i class="bi bi-youtube"></i></a>
            <a href="#" class="btn btn-outline-secondary btn-sm"><i class="bi bi-tiktok"></i></a>
          </div>
        </div>
        <div class="col-lg-2 col-md-6">
          <h6 class="fw-bold mb-3">Hỗ trợ khách hàng</h6>
          <ul class="list-unstyled small">
            <li><a href="#" class="text-muted text-decoration-none hover-light">Trung tâm trợ giúp</a></li>
            <li><a href="#" class="text-muted text-decoration-none">Hướng dẫn mua hàng</a></li>
            <li><a href="#" class="text-muted text-decoration-none">Chính sách đổi trả</a></li>
            <li><a href="#" class="text-muted text-decoration-none">Chính sách bảo hành</a></li>
            <li><a href="#" class="text-muted text-decoration-none">Liên hệ</a></li>
          </ul>
        </div>
        <div class="col-lg-2 col-md-6">
          <h6 class="fw-bold mb-3">VulnShop</h6>
          <ul class="list-unstyled small">
            <li><a href="#" class="text-muted text-decoration-none">Giới thiệu</a></li>
            <li><a href="#" class="text-muted text-decoration-none">Tuyển dụng</a></li>
            <li><a href="#" class="text-muted text-decoration-none">Điều khoản sử dụng</a></li>
            <li><a href="#" class="text-muted text-decoration-none">Chính sách bảo mật</a></li>
            <li><a href="/products" class="text-muted text-decoration-none">Sản phẩm mới</a></li>
          </ul>
        </div>
        <div class="col-lg-2 col-md-6">
          <h6 class="fw-bold mb-3">Phương thức thanh toán</h6>
          <div class="d-flex flex-wrap gap-2">
            <span class="badge bg-secondary">VISA</span>
            <span class="badge bg-secondary">MasterCard</span>
            <span class="badge bg-secondary">MoMo</span>
            <span class="badge bg-secondary">ZaloPay</span>
            <span class="badge bg-secondary">COD</span>
            <span class="badge bg-secondary">Chuyển khoản</span>
          </div>
        </div>
        <div class="col-lg-3 col-md-6">
          <h6 class="fw-bold mb-3">Đăng ký nhận tin</h6>
          <div class="input-group">
            <input type="email" class="form-control form-control-sm" placeholder="Email của bạn" id="newsletter-email">
            <button class="btn btn-warning btn-sm" onclick="subscribeNewsletter()">Đăng ký</button>
          </div>
          <p class="text-muted small mt-2">Nhận ưu đãi & tin tức mới nhất từ VulnShop</p>
        </div>
      </div>
      <hr class="border-secondary mt-4">
      <div class="d-flex flex-wrap justify-content-between align-items-center">
        <p class="text-muted small mb-0">© 2024 VulnShop. Tất cả các quyền được bảo lưu.</p>
        <p class="text-muted small mb-0">Hotline: <strong class="text-warning">1900-6035</strong> | Email: support@vulnshop.com</p>
      </div>
    </div>
  </footer>

  <script src="https://code.jquery.com/jquery-1.12.4.min.js"></script>
  <!-- Bootstrap 5 JS -->
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
  <!-- Socket.io -->
  <script src="/socket.io/socket.io.js"></script>
  <!-- App JS -->
  <script src="/js/app.js"></script>
  <!-- //# sourceMappingURL=app.js.map -->
  <script>
    // Update cart count from localStorage
    function updateCartBadge() {
      const cart = JSON.parse(localStorage.getItem('cart') || '[]');
      document.querySelectorAll('.cart-count').forEach(el => el.textContent = cart.length);
    }
    updateCartBadge();

    function subscribeNewsletter() {
      const email = document.getElementById('newsletter-email').value;
      document.querySelector('footer .text-muted.small.mt-2').innerHTML =
        'Cảm ơn! Email <b>' + email + '</b> đã được đăng ký.';
    }
  </script>
</body>
</html>
