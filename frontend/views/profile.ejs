<%- include('partials/header') %>
<nav class="crumbs"><a href="/">Trang chủ</a><span>/</span><span>Tài khoản</span></nav>
<section class="section-block"><div class="section-heading"><div><span class="eyebrow">Xin chào, <%= user ? (user.name || user.email) : 'bạn' %></span><h1><%= title %></h1></div></div>
  <% if (successMessage) { %><div class="notice success"><%= successMessage %> <%= orderId || '' %></div><% } %>
  <div class="profile-layout"><aside class="profile-menu"><a class="<%= activeTab === 'profile' ? 'active' : '' %>" href="/profile">Thông tin cá nhân</a><a class="<%= activeTab === 'orders' ? 'active' : '' %>" href="/orders">Đơn hàng của tôi</a><a class="<%= activeTab === 'wishlist' ? 'active' : '' %>" href="/wishlist">Danh sách yêu thích</a><a href="/addresses/<%= user ? user.id : 1 %>">Sổ địa chỉ</a><a href="/logout">Đăng xuất</a></aside>
  <div class="profile-content">
    <% if (activeTab === 'orders' || activeTab === 'tracking') { %><h2>Lịch sử đơn hàng</h2><% if (orders && orders.length) { orders.forEach(function(order) { %><article class="order-card"><div class="order-head"><strong>Mã đơn #<%= order.id %></strong><span class="status-pill"><%= order.status || 'pending' %></span></div><p class="muted"><%= (order.items || []).length %> sản phẩm · <%= formatVND(order.total || 0) %></p><a href="/track/<%= order.id %>">Theo dõi đơn hàng →</a></article><% }); } else { %><div class="empty-state compact"><p>Bạn chưa có đơn hàng nào.</p><a href="/products">Bắt đầu mua sắm</a></div><% } %>
    <% } else if (activeTab === 'wishlist') { %><h2>Sản phẩm yêu thích</h2><div class="product-grid"><% (wishlist || []).forEach(function(item) { %><a class="mini-product" href="/products/<%= item.id %>"><img src="<%= item.image || 'https://placehold.co/240x180?text=VulnShop' %>" alt=""><strong><%= item.name %></strong><span><%= formatVND(item.price) %></span></a><% }); %></div>
    <% } else { %><h2>Thông tin cá nhân</h2><form class="stack-form" action="/profile" method="post"><label>Họ và tên<input name="name" value="<%= user ? user.name || user.username || '' : '' %>"></label><label>Email<input name="email" type="email" value="<%= user ? user.email || '' : '' %>"></label><label>Số điện thoại<input name="phone" value="<%= user ? user.phone || '' : '' %>"></label><button class="button primary" type="submit">Lưu thay đổi</button></form><h2 class="subheading">Đổi mật khẩu</h2><form class="stack-form" action="/profile/change-password" method="post"><label>Mật khẩu mới<input type="password" name="new_password" required></label><label>Nhập lại mật khẩu<input type="password" name="confirm_password" required></label><button class="button secondary" type="submit">Cập nhật mật khẩu</button></form><% } %>
  </div></div>
</section>
<%- include('partials/footer') %>
