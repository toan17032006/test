<%- include('partials/header') %>
<section class="auth-wrap"><div class="auth-card"><a class="back-link" href="/">← Về cửa hàng</a><span class="eyebrow">VulnShop account</span>
  <% if (typeof view !== 'undefined' && view === 'forgot') { %><h1>Quên mật khẩu?</h1><p class="muted">Nhập email để nhận hướng dẫn đặt lại mật khẩu.</p><form class="stack-form" action="/forgot-password" method="post"><label>Email<input type="email" name="email" required autocomplete="email"></label><button class="button primary full-width">Gửi hướng dẫn</button></form>
  <% } else if (typeof view !== 'undefined' && view === 'forgot_sent') { %><h1>Kiểm tra hộp thư</h1><p class="muted">Nếu tài khoản tồn tại, hướng dẫn đặt lại đã được gửi tới <strong><%= email %></strong>.</p><a class="button primary full-width" href="/login">Quay lại đăng nhập</a>
  <% } else if (typeof view !== 'undefined' && view === 'reset') { %><h1>Đặt lại mật khẩu</h1><form class="stack-form" action="/reset-password" method="post"><input type="hidden" name="token" value="<%= token || '' %>"><input type="hidden" name="email" value="<%= email || '' %>"><label>Mật khẩu mới<input type="password" name="new_password" required></label><button class="button primary full-width">Lưu mật khẩu mới</button></form>
  <% } else { %><h1>Đăng nhập</h1><p class="muted">Tiếp tục trải nghiệm mua sắm của bạn.</p><% if (error) { %><div class="notice error"><%= error %></div><% } %><form class="stack-form" action="/login<%= redirect ? '?redirect=' + encodeURIComponent(redirect) : '' %>" method="post"><label>Email<input type="email" name="email" required autocomplete="email"></label><label>Mật khẩu<input type="password" name="password" required autocomplete="current-password"></label><label class="choice"><input type="checkbox" name="remember" value="1"> Ghi nhớ đăng nhập</label><button class="button primary full-width">Đăng nhập</button></form><div class="auth-links"><a href="/forgot-password">Quên mật khẩu?</a><span>Chưa có tài khoản? <a href="/register">Đăng ký</a></span></div><% } %>
</div></section>
<%- include('partials/footer') %>
