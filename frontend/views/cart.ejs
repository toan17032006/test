<%- include('partials/header') %>
<nav class="crumbs"><a href="/">Trang chủ</a><span>/</span><span>Giỏ hàng</span></nav>
<section class="section-block"><div class="section-heading"><div><span class="eyebrow">Sẵn sàng cho bước tiếp theo</span><h1>Giỏ hàng của bạn</h1></div><a class="button secondary" href="/products">Tiếp tục mua sắm</a></div>
  <% if (cart && cart.length) { %><div class="cart-layout"><div class="cart-list"><% cart.forEach(function(item) { %><article class="cart-item"><img src="<%= item.image || 'https://placehold.co/100x100?text=Item' %>" alt=""><div class="cart-item-info"><a href="/products/<%= item.productId %>"><strong><%= item.name %></strong></a><span class="muted">Đơn giá: <%= formatVND(item.price) %></span><label>Số lượng <input class="qty-input" type="number" min="1" value="<%= item.qty %>" onchange="VulnShop.updateCart('<%= item.productId %>',this.value,<%= item.price %>)"></label></div><div class="cart-item-end"><strong><%= formatVND(item.price * item.qty) %></strong><button class="text-button" onclick="VulnShop.removeFromCart('<%= item.productId %>')">Xóa</button></div></article><% }); %></div>
    <aside class="summary-card"><h2>Tóm tắt đơn hàng</h2><div class="summary-line"><span>Tạm tính</span><strong><%= formatVND(total) %></strong></div><div class="summary-line"><span>Phí giao hàng</span><span class="muted">Tính ở bước sau</span></div><hr><div class="summary-line total-line"><span>Tổng cộng</span><strong><%= formatVND(total) %></strong></div><a href="/checkout" class="button primary full-width">Tiến hành thanh toán</a><p class="muted tiny">Giá cuối cùng được xác nhận tại bước thanh toán.</p></aside></div>
  <% } else { %><div class="empty-state"><div class="empty-icon">🛍</div><h2>Giỏ hàng đang trống</h2><p class="muted">Khám phá sản phẩm mới và thêm món bạn yêu thích.</p><a class="button primary" href="/products">Khám phá cửa hàng</a></div><% } %>
</section>
<%- include('partials/footer') %>
